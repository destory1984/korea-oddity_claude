; 팔도 한량(3권)의 Godot 견본: 명동 거리 한 장면.
; 웹의 것(docs/water/)과 같은 그림으로 지어 나란히 견주려는 것이다.

config_version=5

[application]

config/name="Korea Oddity — 명동 거리 견본"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=720
window/size/viewport_height=1040
window/size/window_width_override=450
window/size/window_height_override=650
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[input_devices]

pointing/emulate_touch_from_mouse=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.965, 0.941, 0.886, 1)
