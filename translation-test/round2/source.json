[
  {"id": "s01", "who": "sora", "ko": "이번엔 땅이야? 그럼 걸어가도 되겠다."},
  {"id": "s02", "who": "sora", "ko": "바다가 생각보다 좁다. 금방 왔어."},
  {"id": "s03", "who": "sora", "ko": "어느 애가 할머니야? 다 똑같아."},
  {"id": "s04", "who": "sora", "ko": "지붕이 날아갈 것 같아. 안 날아가네."},
  {"id": "s05", "who": "sora", "ko": "해가 바다에서 나와! 1권에선 안 그랬는데."},
  {"id": "s06", "who": "sora", "ko": "한강이 여기서 시작한대. 진짜 작다."},
  {"id": "s07", "who": "sora", "ko": "할머니 1986년에 여기서 봤구나."},
  {"id": "s08", "who": "sora", "ko": "해가 바위 사이로 들어가. 딱 맞춰 왔다."},
  {"id": "s09", "who": "sora", "ko": "달이 길을 열었대. 2권에서 배운 거다."},
  {"id": "s10", "who": "sora", "ko": "판이 팔만 장이래. 아직 다 있네."},
  {"id": "s11", "who": "sora", "ko": "강이 마을을 안고 돌아. 위에서 보니 보여."},
  {"id": "s12", "who": "sora", "ko": "지붕이 산을 다 가져왔어."},
  {"id": "s13", "who": "sora", "ko": "한자는 같은데 소리가 다르네."},
  {"id": "s14", "who": "sora", "ko": "걷는 거 처음이야. 날면 안 돼?"},
  {"id": "s15", "who": "sora", "ko": "이 긴 그림자, 할머니야?"},
  {"id": "s16", "who": "sora", "ko": "겹쳤다! 산은 그대로네."},
  {"id": "s17", "who": "sora", "ko": "돌리니까 꽃이 피었다 졌다 해."},
  {"id": "s18", "who": "sora", "ko": "배 타고 세 시간이래. 진짜 갈 수 있어?"},
  {"id": "s19", "who": "sora", "ko": "할머니, 안개 없어. 물이 보여."},
  {"id": "s20", "who": "sora", "ko": "할머니, 물은 하늘색이었어."},

  {"id": "m01", "who": "memo", "ko": "1976.4. 맑음. 근정전 마당이 넓었다."},
  {"id": "m02", "who": "memo", "ko": "세 번 올랐다. 세 번 다 안개였다."},
  {"id": "m03", "who": "memo", "ko": "1985.11. 저녁. 산이 겹겹이 보였다."},

  {"id": "g01", "who": "grandmother", "ko": "작아서 천삼백 년을 견뎠단다. 큰 것부터 무너지지."},
  {"id": "g02", "who": "grandmother", "ko": "소라야, 앞의 두 권은 벌써 채웠구나. 고맙다."},
  {"id": "g03", "who": "grandmother", "ko": "이건 내가 다닌 데를 적은 수첩이란다."},
  {"id": "g04", "who": "grandmother", "ko": "사진이 다 바랬구나. 네가 새로 찍어다 주련."},
  {"id": "g05", "who": "grandmother", "ko": "첫 장은 열일곱 살 나다."},
  {"id": "g06", "who": "grandmother", "ko": "세 번 올랐는데 세 번 안개였단다."},
  {"id": "g07", "who": "grandmother", "ko": "물이 있다는데 한 번을 못 봤지."},
  {"id": "g08", "who": "grandmother", "ko": "네가 봤으니 됐다. 무슨 색인지 적어 주련."},
  {"id": "g09", "who": "grandmother", "ko": "나는 그걸로 됐다."},
  {"id": "g10", "who": "grandmother", "ko": "친구 카메라를 빌렸단다."},
  {"id": "g11", "who": "grandmother", "ko": "돌은 기다릴 줄 안단다."},
  {"id": "g12", "who": "grandmother", "ko": "동쪽에서 보고 서쪽에서 보렴."},
  {"id": "g13", "who": "grandmother", "ko": "도시 불이 없어야 보인단다."},
  {"id": "g14", "who": "grandmother", "ko": "한강은 샘 하나에서 온단다."},
  {"id": "g15", "who": "grandmother", "ko": "해를 등지고 찍었더니 내가 들어갔구나."},
  {"id": "g16", "who": "grandmother", "ko": "글자가 살던 데란다."},
  {"id": "g17", "who": "grandmother", "ko": "날지 말고 걸어 보렴."},
  {"id": "g18", "who": "grandmother", "ko": "배 두 번, 안개 세 번이란다."},
  {"id": "g19", "who": "grandmother", "ko": "가기 전에 확인하렴."},
  {"id": "g20", "who": "grandmother", "ko": "이 자리를 찾아보렴."},
  {"id": "g21", "who": "grandmother", "ko": "번역이 어색하면 알려 주렴."},
  {"id": "g22", "who": "grandmother", "ko": "맞혀 보렴."}
]
