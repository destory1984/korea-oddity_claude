[
  {"id": "63.memo", "ko": "1971.5.12. 수학여행. 단체사진을 찍었다."},
  {"id": "63.sora", "ko": "어느 애가 할머니야? 다 똑같아."},
  {"id": "63.card1", "ko": "첨성대는 신라 선덕여왕 때 세운 돌탑이다."},
  {"id": "63.card2", "ko": "높이는 약 9미터이다."},
  {"id": "63.card3", "ko": "사람들은 이 탑에서 별을 보았다고 전한다."},
  {"id": "63.quiz", "ko": "첨성대는 어느 나라 때 세웠을까?"},
  {"id": "63.route1", "ko": "김해공항이나 부산항으로 들어온다."},
  {"id": "63.route2", "ko": "부산에서 경주까지 기차나 버스를 탄다."},
  {"id": "63.route3", "ko": "첨성대는 밤에도 볼 수 있다."},

  {"id": "1.memo", "ko": "1976.4. 맑음. 근정전 마당이 넓었다."},
  {"id": "1.sora", "ko": "지붕이 날아갈 것 같아. 안 날아가네."},
  {"id": "1.card1", "ko": "경복궁은 조선의 첫 번째 궁궐이다."},
  {"id": "1.card2", "ko": "조선은 1395년에 경복궁을 지었다."},
  {"id": "1.card3", "ko": "근정전은 왕이 신하를 만나던 건물이다."},
  {"id": "1.quiz", "ko": "경복궁은 몇 년에 지었을까?"},
  {"id": "1.route1", "ko": "인천공항으로 들어온다."},
  {"id": "1.route2", "ko": "공항철도를 타고 서울역까지 간다."},
  {"id": "1.route3", "ko": "경복궁은 화요일에 쉰다."},

  {"id": "54.memo", "ko": "텔레비전에서 봤다. 바다에 길이 났다."},
  {"id": "54.sora", "ko": "달이 길을 열었대. 2권에서 배운 거다."},
  {"id": "54.card1", "ko": "진도 앞바다는 1년에 몇 번 갈라진다."},
  {"id": "54.card2", "ko": "물이 빠지면 약 2.8킬로미터의 바닷길이 나타난다."},
  {"id": "54.card3", "ko": "달이 바닷물을 끌어당겨서 생기는 일이다."},
  {"id": "54.quiz", "ko": "바닷길은 무엇이 여는 것일까?"},
  {"id": "54.route1", "ko": "인천공항이나 김해공항으로 들어온다."},
  {"id": "54.route2", "ko": "목포역까지 기차를 타고, 진도까지 버스를 탄다."},
  {"id": "54.route3", "ko": "바닷길은 봄에 며칠만 열린다."},

  {"id": "66.memo", "ko": "1982.10. 흐림. 판전 안은 서늘했다."},
  {"id": "66.sora", "ko": "판이 팔만 장이래. 아직 다 있네."},
  {"id": "66.card1", "ko": "해인사 장경판전은 나무 판을 보관하는 건물이다."},
  {"id": "66.card2", "ko": "나무 판은 8만 장이 넘는다."},
  {"id": "66.card3", "ko": "고려는 13세기에 이 판을 새겼다."},
  {"id": "66.quiz", "ko": "나무 판은 몇 장이 넘을까?"},
  {"id": "66.route1", "ko": "김해공항이나 부산항으로 들어온다."},
  {"id": "66.route2", "ko": "대구까지 기차를 타고, 해인사까지 버스를 탄다."},
  {"id": "66.route3", "ko": "판전은 밖에서 창살 사이로 본다."},

  {"id": "100.memo", "ko": "세 번 올랐다. 세 번 다 안개였다."},
  {"id": "100.sora", "ko": "할머니, 안개 없어. 물이 보여."},
  {"id": "100.card1", "ko": "한라산은 한국에서 가장 높은 산이다."},
  {"id": "100.card2", "ko": "높이는 1,947미터이다."},
  {"id": "100.card3", "ko": "백록담은 산꼭대기에 있는 화구호이다."},
  {"id": "100.quiz", "ko": "한라산의 높이는 몇 미터일까?"},
  {"id": "100.route1", "ko": "제주공항으로 들어온다."},
  {"id": "100.route2", "ko": "성판악까지 버스를 탄다."},
  {"id": "100.route3", "ko": "정상에 오르려면 미리 예약해야 한다."},

  {"id": "22.memo", "ko": "책에서 봤다. 역 바로 앞이 바다다."},
  {"id": "22.sora", "ko": "해가 바다에서 나와! 1권에선 안 그랬는데."},
  {"id": "22.card1", "ko": "정동진역은 바다와 아주 가까운 기차역이다."},
  {"id": "22.card2", "ko": "승강장에서 바다가 보인다."},
  {"id": "22.card3", "ko": "많은 사람이 새해 첫날 해돋이를 보러 온다."},
  {"id": "22.quiz", "ko": "정동진은 한국의 어느 쪽 바다에 있을까?"},
  {"id": "22.route1", "ko": "인천공항으로 들어온다."},
  {"id": "22.route2", "ko": "서울역에서 강릉 방향 기차를 탄다."},
  {"id": "22.route3", "ko": "해 뜨는 시각은 계절마다 다르다."},

  {"id": "30.memo", "ko": "신문에서 봤다. 한강의 첫 샘이다."},
  {"id": "30.sora", "ko": "한강이 여기서 시작한대. 진짜 작다."},
  {"id": "30.card1", "ko": "검룡소는 한강이 시작하는 샘이다."},
  {"id": "30.card2", "ko": "이 샘에서 하루에 약 2천 톤의 물이 나온다."},
  {"id": "30.card3", "ko": "물은 약 500킬로미터를 흘러 서해로 간다."},
  {"id": "30.quiz", "ko": "한강은 어느 바다로 흘러갈까?"},
  {"id": "30.route1", "ko": "인천공항으로 들어온다."},
  {"id": "30.route2", "ko": "서울에서 태백까지 기차나 버스를 탄다."},
  {"id": "30.route3", "ko": "주차장에서 샘까지 약 20분 걷는다."},

  {"id": "38.memo", "ko": "1988.8. 맑음. 해가 바위 사이로 졌다."},
  {"id": "38.sora", "ko": "해가 바위 사이로 들어가. 딱 맞춰 왔다."},
  {"id": "38.card1", "ko": "꽃지 해변은 서해에 있는 모래 해변이다."},
  {"id": "38.card2", "ko": "바다에 바위 두 개가 서 있다."},
  {"id": "38.card3", "ko": "저녁에 해가 두 바위 사이로 진다."},
  {"id": "38.quiz", "ko": "꽃지 해변에서는 해가 뜰까, 질까?"},
  {"id": "38.route1", "ko": "인천공항으로 들어온다."},
  {"id": "38.route2", "ko": "서울에서 태안까지 버스를 탄다."},
  {"id": "38.route3", "ko": "물이 빠지면 바위까지 걸어갈 수 있다."},

  {"id": "67.memo", "ko": "1984.10. 맑음. 부용대에 올라가 찍었다."},
  {"id": "67.sora", "ko": "강이 마을을 안고 돌아. 위에서 보니 보여."},
  {"id": "67.card1", "ko": "하회마을은 600년 넘게 사람이 사는 마을이다."},
  {"id": "67.card2", "ko": "낙동강이 마을을 둥글게 돌아 흐른다."},
  {"id": "67.card3", "ko": "마을 이름 하회(河回)는 강이 돈다는 뜻이다."},
  {"id": "67.quiz", "ko": "하회마을을 돌아 흐르는 강의 이름은 무엇일까?"},
  {"id": "67.route1", "ko": "인천공항이나 김해공항으로 들어온다."},
  {"id": "67.route2", "ko": "안동역까지 기차를 타고, 마을까지 버스를 탄다."},
  {"id": "67.route3", "ko": "마을에는 지금도 사람이 산다."},

  {"id": "68.memo", "ko": "1985.11. 저녁. 산이 겹겹이 보였다."},
  {"id": "68.sora", "ko": "지붕이 산을 다 가져왔어."},
  {"id": "68.card1", "ko": "부석사는 신라의 의상이 676년에 세운 절이다."},
  {"id": "68.card2", "ko": "무량수전은 한국에서 가장 오래된 나무 건물 가운데 하나이다."},
  {"id": "68.card3", "ko": "무량수전 앞에 서면 소백산 줄기가 보인다."},
  {"id": "68.quiz", "ko": "부석사는 몇 년에 세웠을까?"},
  {"id": "68.route1", "ko": "인천공항으로 들어온다."},
  {"id": "68.route2", "ko": "영주역까지 기차를 타고, 부석사까지 버스를 탄다."},
  {"id": "68.route3", "ko": "해 질 때의 경치가 유명하다."},

  {"id": "common.route", "ko": "가기 전에 확인하렴."},

  {"id": "line1.sora", "ko": "이번엔 땅이야? 그럼 걸어가도 되겠다."},
  {"id": "line2.sora", "ko": "바다가 생각보다 좁다. 금방 왔어."},
  {"id": "line7.sora", "ko": "할머니 1986년에 여기서 봤구나."},
  {"id": "line13.sora", "ko": "한자는 같은데 소리가 다르네."},
  {"id": "line14.sora", "ko": "걷는 거 처음이야. 날면 안 돼?"},
  {"id": "line15.sora", "ko": "이 긴 그림자, 할머니야?"},
  {"id": "line16.sora", "ko": "겹쳤다! 산은 그대로네."},
  {"id": "line17.sora", "ko": "돌리니까 꽃이 피었다 졌다 해."},
  {"id": "line18.sora", "ko": "배 타고 세 시간이래. 진짜 갈 수 있어?"},
  {"id": "line20.sora", "ko": "할머니, 물은 하늘색이었어."}
]
