[
  {"id": "63.card1", "ko": "{첨성대}는 {신라}의 {선덕여왕} 때 세운 돌탑이다."},
  {"id": "63.card2", "ko": "높이는 약 9미터이다."},
  {"id": "63.card3", "ko": "사람들은 이 탑에서 별을 관측했다고 전한다."},
  {"id": "63.quiz", "ko": "어느 나라가 {첨성대}를 세웠을까?"},
  {"id": "63.route1", "ko": "{김해공항}이나 {부산항}으로 입국한다."},
  {"id": "63.route2", "ko": "{부산}에서 {경주}까지 열차나 버스를 탄다."},
  {"id": "63.route3", "ko": "{첨성대}는 밤에도 볼 수 있다."},

  {"id": "1.card1", "ko": "{경복궁}은 {조선}의 첫 번째 궁궐이다."},
  {"id": "1.card2", "ko": "{조선}은 1395년에 {경복궁}을 지었다."},
  {"id": "1.card3", "ko": "{근정전}은 왕이 신하를 만나던 건물이다."},
  {"id": "1.quiz", "ko": "{조선}은 몇 년에 {경복궁}을 지었을까?"},
  {"id": "1.route1", "ko": "{인천공항}으로 입국한다."},
  {"id": "1.route2", "ko": "{공항철도}를 타고 {서울역}까지 간다."},
  {"id": "1.route3", "ko": "{경복궁}은 화요일에 쉰다."},

  {"id": "54.card1", "ko": "{진도}의 바다는 해마다 몇 번 갈라진다."},
  {"id": "54.card2", "ko": "물이 빠지면 약 2.8킬로미터의 바닷길이 나타난다."},
  {"id": "54.card3", "ko": "달이 바닷물을 끌어당겨서 생기는 일이다."},
  {"id": "54.quiz", "ko": "무엇이 바닷길을 열까?"},
  {"id": "54.route1", "ko": "{인천공항}이나 {김해공항}으로 입국한다."},
  {"id": "54.route2", "ko": "{목포역}까지 열차를 타고, {진도}까지 버스를 탄다."},
  {"id": "54.route3", "ko": "바닷길이 열리는 날은 해마다 다르다."},

  {"id": "66.card1", "ko": "{해인사} {장경판전}은 경판을 보관하는 건물이다."},
  {"id": "66.card2", "ko": "경판은 8만 장이 넘는다."},
  {"id": "66.card3", "ko": "{고려}는 13세기에 이 경판을 새겼다."},
  {"id": "66.quiz", "ko": "경판은 몇 장이 넘을까?"},
  {"id": "66.route1", "ko": "{김해공항}이나 {부산항}으로 입국한다."},
  {"id": "66.route2", "ko": "{대구}까지 열차를 타고, {해인사}까지 버스를 탄다."},
  {"id": "66.route3", "ko": "{장경판전}은 밖에서 창살 사이로 본다."},

  {"id": "100.card1", "ko": "{한라산}은 {한국}에서 가장 높은 산이다."},
  {"id": "100.card2", "ko": "높이는 1,947미터이다."},
  {"id": "100.card3", "ko": "{백록담}은 산 정상에 있는 화구호이다."},
  {"id": "100.quiz", "ko": "{한라산}의 높이는 몇 미터일까?"},
  {"id": "100.route1", "ko": "{제주공항}으로 입국한다."},
  {"id": "100.route2", "ko": "{성판악}까지 버스를 탄다."},
  {"id": "100.route3", "ko": "정상에 오르려면 미리 예약해야 한다."},

  {"id": "22.card1", "ko": "{정동진역}은 바다와 아주 가까운 역이다."},
  {"id": "22.card2", "ko": "승강장에서 바다가 보인다."},
  {"id": "22.card3", "ko": "많은 사람이 1월 1일에 해돋이를 보러 온다."},
  {"id": "22.quiz", "ko": "{정동진}은 {한국}의 어느 쪽에 있을까?"},
  {"id": "22.route1", "ko": "{인천공항}으로 입국한다."},
  {"id": "22.route2", "ko": "{서울역}에서 {강릉} 방향 열차를 탄다."},
  {"id": "22.route3", "ko": "해 뜨는 시각은 계절마다 다르다."},

  {"id": "30.card1", "ko": "{검룡소}는 {한강}이 시작하는 샘이다."},
  {"id": "30.card2", "ko": "이 샘에서 하루에 약 2천 톤의 물이 나온다."},
  {"id": "30.card3", "ko": "물은 약 500킬로미터를 흘러 바다로 간다."},
  {"id": "30.quiz", "ko": "{한강}은 어디에서 시작할까?"},
  {"id": "30.route1", "ko": "{인천공항}으로 입국한다."},
  {"id": "30.route2", "ko": "{서울}에서 {태백}까지 열차나 버스를 탄다."},
  {"id": "30.route3", "ko": "주차장에서 샘까지 약 20분 걷는다."},

  {"id": "38.card1", "ko": "{꽃지 해변}은 서쪽 바다에 있는 모래 해변이다."},
  {"id": "38.card2", "ko": "바다에 바위 두 개가 서 있다."},
  {"id": "38.card3", "ko": "저녁에 해가 두 바위 사이로 진다."},
  {"id": "38.quiz", "ko": "{꽃지 해변}에서는 해가 뜰까, 질까?"},
  {"id": "38.route1", "ko": "{인천공항}으로 입국한다."},
  {"id": "38.route2", "ko": "{서울}에서 {태안}까지 버스를 탄다."},
  {"id": "38.route3", "ko": "썰물 때는 바위까지 걸어갈 수 있다."},

  {"id": "67.card1", "ko": "{하회마을}은 600년 넘게 사람이 사는 마을이다."},
  {"id": "67.card2", "ko": "{낙동강}이 마을을 둥글게 돌아 흐른다."},
  {"id": "67.card3", "ko": "{하회마을}의 이름은 강이 돈다는 뜻이다."},
  {"id": "67.quiz", "ko": "어느 강이 {하회마을}을 돌아 흐를까?"},
  {"id": "67.route1", "ko": "{인천공항}이나 {김해공항}으로 입국한다."},
  {"id": "67.route2", "ko": "{안동역}까지 열차를 타고, 마을까지 버스를 탄다."},
  {"id": "67.route3", "ko": "마을에는 지금도 사람이 산다."},

  {"id": "68.card1", "ko": "{부석사}는 {신라}의 {의상}이 676년에 세운 절이다."},
  {"id": "68.card2", "ko": "{무량수전}은 {한국}에서 가장 오래된 목조 건물 가운데 하나이다."},
  {"id": "68.card3", "ko": "{무량수전} 앞에 서면 {소백산} 능선이 보인다."},
  {"id": "68.quiz", "ko": "{의상}은 몇 년에 {부석사}를 세웠을까?"},
  {"id": "68.route1", "ko": "{인천공항}으로 입국한다."},
  {"id": "68.route2", "ko": "{영주역}까지 열차를 타고, {부석사}까지 버스를 탄다."},
  {"id": "68.route3", "ko": "해 질 때의 경치가 유명하다."}
]
